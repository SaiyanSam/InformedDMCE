<launch>
    <arg name="nRobots" default="3"/>
    <arg name="plannerType" default="skyline"/>

    <node pkg="dmce_skyline" type="skyline_server_node" name="skyline_server" output="screen">
        <param name="robot_count" value="$(arg nRobots)"/> 
    </node>

    <group ns="robot_0">
        <include file="$(find dmce_core)/launch/agent.launch">
            <arg name="robot_id" value="0"/>
            <arg name="plannerType" value="$(arg plannerType)"/>
        </include>
    </group>

    <group ns="robot_1">
        <include file="$(find dmce_core)/launch/agent.launch">
            <arg name="robot_id" value="1"/>
            <arg name="plannerType" value="$(arg plannerType)"/>
        </include>
    </group>

    <group ns="robot_2">
        <include file="$(find dmce_core)/launch/agent.launch">
            <arg name="robot_id" value="2"/>
            <arg name="plannerType" value="$(arg plannerType)"/>
        </include>
    </group>

    </launch>